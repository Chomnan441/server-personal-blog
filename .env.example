PORT=4000

# Supabase Postgres — local dev: use Transaction pooler port 6543
# postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres
CONNECTION_STRING=

SUPABASE_URL=
SUPABASE_ANON_KEY=

# Required for Storage upload/delete (avatars, posts, hero images)
SUPABASE_SERVICE_ROLE_KEY=

FRONTEND_URL=http://localhost:5173

# Optional: extra CORS origins (comma-separated)
# CORS_ORIGINS=
